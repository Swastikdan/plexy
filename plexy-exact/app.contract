shape Readiness
  title: string
  message: string

routes nav
  home "/"

component PlexyExact
  resource readiness = readiness() as shape Readiness
  view
    main testId="root" width="100%" height="100%"
      column padding=24 gap=16
        text readiness.title role="heading" aria-level=1
        text readiness.message testId="status"
