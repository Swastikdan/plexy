{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["*"] },
    "typecheck": { "dependsOn": ["transit"] },
    "typecheck:tests": { "dependsOn": ["transit"] },
    "//#typecheck:scripts": { "cache": false },
    "@plexy/web#typecheck": { "dependsOn": ["transit", "build"] },
    "lint": {},
    "lint:strict": {},
    "test": { "cache": false, "passThroughEnv": ["*"] },
    "@plexy/web#build": {
      "dependsOn": ["transit"],
      "env": ["NODE_ENV", "VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["$TURBO_ROOT$/dist/web/**", "src/routeTree.gen.ts"]
    },
    "compile": { "cache": false, "passThroughEnv": ["*"] },
    "build:main": { "cache": false, "passThroughEnv": ["*"] },
    "assemble:server": {
      "dependsOn": ["compile"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "package:desktop": {
      "dependsOn": ["build:main", "@plexy/server#compile"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "bundle": { "cache": false, "passThroughEnv": ["*"] },
    "apk": { "cache": false, "passThroughEnv": ["*"] }
  }
}
