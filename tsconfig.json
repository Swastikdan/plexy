{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@plexy/tsconfig/bun.json",
  "compilerOptions": {
    "paths": {
      "@plexy/api-client": ["./packages/api-client/src/index.ts"],
      "@plexy/api-client/*": ["./packages/api-client/src/*"],
      "@plexy/local-library": ["./packages/local-library/src/library.ts"],
      "@plexy/local-library/*": ["./packages/local-library/src/*"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
