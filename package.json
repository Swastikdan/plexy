{
  "name": "plexy-monorepo",
  "version": "1.0.7",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"bun run --filter @plexy/server dev\" \"bun run --filter @plexy/web dev --host\"",
    "dev:server": "bun run --filter @plexy/server dev",
    "dev:web": "bun run --filter @plexy/web dev --host",
    "dev:desktop": "bun run --filter @plexy/desktop dev",
    "build": "bun run build:web && PLEXY_REUSE_WEB_BUILD=true bun run build:desktop && PLEXY_REUSE_WEB_BUILD=true bun run build:server && bun run build:mobile",
    "build:web": "bun run --filter @plexy/web build",
    "build:desktop": "bun scripts/build-desktop.ts",
    "build:server": "bun scripts/build-server.ts",
    "build:backend": "bun scripts/build-server.ts",
    "build:mobile": "bun scripts/native/build-preview.ts",
    "icons:pwa": "bun scripts/generate-pwa-icons.ts",
    "package:mac": "bun scripts/build-desktop.ts",
    "start": "bun run --filter @plexy/server start",
    "test": "bun scripts/test-server.ts",
    "test:server": "bun scripts/test-server.ts",
    "test:packages": "bun test packages/local-library/tests",
    "typecheck": "bun run --filter @plexy/server typecheck && bun run --filter @plexy/web typecheck && bun run --filter @plexy/desktop typecheck && bun run --filter @plexy/api-client typecheck && bun run --filter @plexy/local-library typecheck && bun x tsc --noEmit -p tsconfig.json",
    "dev:mobile": "bun run --filter @plexy/mobile start",
    "android:mobile": "bun run --filter @plexy/mobile android",
    "typecheck:native": "bun run --filter @plexy/mobile typecheck",
    "test:native": "bun test apps/mobile/tests packages/local-library/tests",
    "bundle:native": "bun run --filter @plexy/mobile bundle",
    "build:native:preview": "bun scripts/native/build-preview.ts",
    "test:desktop": "bun test apps/desktop/tests"
  },
  "devDependencies": {
    "@plexy/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "electron-builder": "^26.18.0",
    "node-av": "^6.1.1",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "node-av"
  ],
  "patchedDependencies": {
    "expo-modules-core@57.0.26": "patches/expo-modules-core@57.0.26.patch",
    "expo-video@57.0.5": "patches/expo-video@57.0.5.patch"
  }
}
