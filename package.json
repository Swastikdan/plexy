{
  "name": "plexy-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"bun run --filter @plexy/server dev\" \"bun run --filter @plexy/web dev --host\"",
    "dev:server": "bun run --filter @plexy/server dev",
    "dev:web": "bun run --filter @plexy/web dev --host",
    "dev:desktop": "bun apps/desktop/build.ts && ./node_modules/.bin/electron apps/desktop",
    "build": "bun run build:web && bun run build:desktop",
    "build:web": "bun run --filter @plexy/web build",
    "build:desktop": "bun scripts/build-desktop.ts",
    "build:executable": "bun scripts/build-executable.ts",
    "build:server": "bun scripts/build-executable.ts",
    "package:mac": "bun scripts/build-desktop.ts",
    "deploy:web": "bun scripts/deploy-web.ts",
    "deploy:web:dry": "bun scripts/deploy-web.ts --dry-run",
    "start": "bun run --filter @plexy/server start",
    "test": "NODE_ENV=test bun test apps/server/tests",
    "test:server": "NODE_ENV=test bun test apps/server/tests",
    "typecheck": "bun run --filter @plexy/server typecheck && bun run --filter @plexy/web typecheck && bun x tsc --noEmit -p apps/desktop/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "clsx": "^2.1.1",
    "elysia": "^1.4.30",
    "hls-video-element": "^1.5.12",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.0",
    "player.style": "^0.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "node-av": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "trustedDependencies": [
    "node-av"
  ]
}
