{
  "name": "plexy-monorepo",
  "version": "1.0.8",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@plexy/server --filter=@plexy/web",
    "dev:admin": "PLEXY_DEV_ADMIN=1 turbo run dev --filter=@plexy/server --filter=@plexy/web",
    "dev:desktop": "turbo run dev --filter=@plexy/desktop",
    "dev:mobile": "turbo run dev --filter=@plexy/mobile",
    "build": "bun run build:web && turbo run assemble:server package:desktop && bun run build:mobile",
    "build:web": "turbo run build --filter=@plexy/web",
    "build:desktop": "bun run build:web && turbo run package:desktop --filter=@plexy/desktop",
    "build:desktop:minimal": "PLEXY_FFMPEG_VARIANT=custom bun run build:desktop",
    "ffmpeg:minimal": "bash scripts/build-minimal-ffmpeg.sh",
    "build:server": "bun run build:web && turbo run assemble:server --filter=@plexy/server",
    "build:server:minimal": "PLEXY_FFMPEG_VARIANT=custom bun run build:server",
    "build:mobile": "turbo run apk --filter=@plexy/mobile",
    "build:check": "bun run arch:check && turbo run typecheck typecheck:scripts lint test build build:main bundle && turbo run assemble:server --filter=@plexy/server",
    "build:check:mobile": "turbo run typecheck lint test bundle --filter=@plexy/mobile --filter=@plexy/local-library",
    "icons:pwa": "bun scripts/generate-pwa-icons.ts",
    "package:mac": "bun run build:desktop",
    "start": "bun run --filter @plexy/server start",
    "test": "turbo run test",
    "test:server": "turbo run test --filter=@plexy/server",
    "test:packages": "turbo run test --filter=@plexy/local-library",
    "test:desktop": "turbo run test --filter=@plexy/desktop",
    "test:native": "turbo run test --filter=@plexy/mobile --filter=@plexy/local-library",
    "test:native:coverage": "bun scripts/test-native.ts",
    "typecheck": "turbo run typecheck typecheck:scripts --filter=!@plexy/mobile",
    "typecheck:native": "turbo run typecheck --filter=@plexy/mobile",
    "typecheck:tests": "turbo run typecheck:tests --filter=@plexy/mobile",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json",
    "perf:check": "bun scripts/perf-check.ts",
    "arch:check": "bun scripts/architecture-check.ts",
    "android:mobile": "bun run --filter @plexy/mobile android",
    "e2e:android": "maestro test apps/mobile/.maestro",
    "e2e:android:smoke": "maestro test apps/mobile/.maestro --include-tags=smoke",
    "bundle:native": "turbo run bundle --filter=@plexy/mobile",
    "licenses:mobile": "bun scripts/native/generate-licenses.ts",
    "licenses:mobile:check": "bun scripts/native/generate-licenses.ts --check"
  },
  "devDependencies": {
    "@plexy/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "node-av": "^6.1.1",
    "typescript": "^7.0.2",
    "turbo": "2.11.12"
  },
  "trustedDependencies": [
    "node-av"
  ],
  "patchedDependencies": {
    "expo-modules-core@57.0.26": "patches/expo-modules-core@57.0.26.patch",
    "expo-video@57.0.5": "patches/expo-video@57.0.5.patch"
  }
}
