# Copy to `.env.deploy` (gitignored) to deploy the hosted web client locally:
#   bun run deploy:web
#
# Shell environment variables take precedence over this file.

# Cloudflare API token with "Workers Scripts: Edit" permission.
# Leave both Cloudflare lines out to use `npx --yes wrangler@4 login` instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: default Plexy server address baked into the hosted build.
# Must be HTTPS, because the hosted page is served over HTTPS.
# Viewers can still change it from the Server button.
PLEXY_DEFAULT_SERVER_URL=
