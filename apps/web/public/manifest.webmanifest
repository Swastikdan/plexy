{
  "id": "/",
  "name": "Plexy Client",
  "short_name": "Plexy",
  "description": "Your own film and TV library, streamed from your Plexy Server.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080808",
  "theme_color": "#080808",
  "categories": ["video", "entertainment"],
  "icons": [
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "url": "/search"
    },
    {
      "name": "Movies",
      "short_name": "Movies",
      "url": "/library/movies"
    },
    {
      "name": "TV Shows",
      "short_name": "TV",
      "url": "/library/tv"
    }
  ]
}
