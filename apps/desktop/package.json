{
  "name": "@plexy/desktop",
  "version": "1.0.8",
  "description": "Plexy Beta desktop app for macOS",
  "author": "Plexy",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "bun build.ts",
    "dev": "bun run build:main && electron .",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && bun test apps/desktop/tests",
    "package:desktop": "cd ../.. && bun scripts/build-desktop.ts"
  },
  "dependencies": {
    "@plexy/desktop-bridge": "workspace:*",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@plexy/tsconfig": "workspace:*",
    "@types/node": "^22.10.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
