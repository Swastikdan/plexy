{
  "appId": "com.plexy.desktop",
  "productName": "Plexy",
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "directories": {
    "app": "apps/desktop",
    "output": "dist/mac",
    "buildResources": "build"
  },
  "electronLanguages": ["en"],
  "files": [
    "dist/**/*",
    "package.json",
    "!**/node_modules/**"
  ],
  "extraResources": [
    {
      "from": "dist/bin/plexy-server",
      "to": "bin/plexy-server"
    },
    {
      "from": "dist/bin/ffmpeg",
      "to": "bin/ffmpeg"
    },
    {
      "from": "dist/migrations",
      "to": "migrations"
    },
    {
      "from": "dist/web",
      "to": "web"
    },
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "build/icon.icns",
      "to": "icon.icns"
    }
  ],
  "icon": "build/icon.icns",
  "mac": {
    "category": "public.app-category.video",
    "icon": "build/icon.icns",
    "identity": "-",
    "target": [
      {
        "target": "dir",
        "arch": ["arm64"]
      },
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "format": "ULFO",
    "title": "${productName} ${version}",
    "icon": null,
    "background": "build/background.png",
    "iconSize": 96,
    "iconTextSize": 13,
    "contents": [
      {
        "x": 162,
        "y": 188,
        "type": "file"
      },
      {
        "x": 470,
        "y": 188,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
