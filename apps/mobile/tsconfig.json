{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@plexy/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@plexy/local-library/*": [
        "../../packages/local-library/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "tests",
    "node_modules"
  ]
}
