{
  "name": "@plexy/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun ../../scripts/test-server.ts",
    "typecheck": "tsc --noEmit",
    "compile": "cd ../.. && bun build --compile --minify --outfile=apps/server/dist/plexy-server apps/server/src/main.ts",
    "assemble:server": "cd ../.. && bun scripts/build-server.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@peculiar/x509": "^3.1.0",
    "@plexy/api-client": "workspace:*",
    "bonjour-service": "^1.4.4",
    "elysia": "^1.4.30",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@plexy/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
